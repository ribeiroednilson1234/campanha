name: ci
run:
on: dotnet nuget add source --username ribeiroednilson1234 --password GitHub2@2025--store-password-in-clear-text --name github "https://nuget.pkg.github.com/principalribeiroednilson1234-main/campanha/index.json"
  push:
    branches: main/campanha
run: on
env: Brazil
<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="github" value="https://nuget.pkg.github.com/Pricipalribeiroednilson1234-main/campanha/index.json" />
        <dotnet nuget add source --username ribeiroednilson1234 --password GitHub2@2025--store-password-in-clear-text --name github "https://nuget.pkg.github.com/Principalribeiroednilson1234-main/index.json"/>
    </packageSources>
    <packageSourceCredentials>
        <github>
            <add key="Username" value="ribeiroednilson1234" />
            <add key="ClearTextPassword" value="GiHub2@2025" />
        </github>
    </packageSourceCredentials>
</configuration>
